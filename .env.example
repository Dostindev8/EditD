# Copy to .env (API) and apps/web/.env.local (web). Never commit secrets.

# --- API (apps/api) ---
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=true

MONGODB_URI=mongodb://127.0.0.1:27017/lcs_dominican
ALLOW_MEMORY_MONGO=true
POSTGRES_URL=postgresql://lcs:lcs@127.0.0.1:5432/lcs_billing
REDIS_URL=

# RS256 PEM (optional). If empty, API generates ephemeral keys in .keys/ (dev only).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

ADMIN_EMAIL=admin@editd.ai
ADMIN_PASSWORD=EditDAdmin2026!
ADMIN_EMAIL_LCS=admin@logiccodespot.com
ADMIN_PASSWORD_LCS=LCSAdmin2026!

# AI orchestrator — never hardcode. Fallback chain if Claude fails.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_TIMEOUT_MS=25000

# Phase 1 — generation + governance
RUNWAY_API_KEY=
GOOGLE_VEO_API_KEY=
RUNWAY_DEFAULT_COST_CENTS=120
VEO_DEFAULT_COST_CENTS=150
GENERATION_COST_CENTS_PER_SEC=8
GENERATION_POLL_TIMEOUT_MS=180000
MOCK_VIDEO_URL=
CLOUDINARY_URL=
S3_BUCKET=
WEBHOOK_HMAC_SECRET=

# --- Web ---
# Leave NEXT_PUBLIC_API_URL empty so the Next.js rewrite keeps cookies same-origin.
# Local rewrite target (server-only):
API_PROXY=http://localhost:4000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=

