# Copy to .env (API) and apps/web/.env.local (web). Never commit secrets.

# --- API (apps/api) ---
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
# CSV of exact origins allowed for CORS + cookies (no wildcards like *.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
TRUST_PROXY=true

MONGODB_URI=mongodb://127.0.0.1:27017/lcs_dominican
ALLOW_MEMORY_MONGO=true
POSTGRES_URL=postgresql://lcs:lcs@127.0.0.1:5432/lcs_billing
# Required in production — Redis/Upstash URL for BullMQ + session-safe cache
REDIS_URL=

# RS256 PEM — REQUIRED in production. In development, ephemeral keys may be generated under .keys/
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=604800
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

ADMIN_EMAIL=admin@editd.ai
ADMIN_PASSWORD=changeme-generate-a-strong-secret
ADMIN_EMAIL_LCS=admin@logiccodespot.com
ADMIN_PASSWORD_LCS=changeme-generate-a-strong-secret

# AI orchestrator — never hardcode. Fallback chain if Claude fails.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
AI_TIMEOUT_MS=25000

# Phase 1 — generation + governance
RUNWAY_API_KEY=
GOOGLE_VEO_API_KEY=
MUAPI_API_KEY=
MINIMAX_API_KEY=
RUNWAY_DEFAULT_COST_CENTS=120
VEO_DEFAULT_COST_CENTS=150
GENERATION_COST_CENTS_PER_SEC=8
GENERATION_POLL_TIMEOUT_MS=180000
MOCK_VIDEO_URL=
CLOUDINARY_URL=
S3_BUCKET=
WEBHOOK_HMAC_SECRET=

# Self-hosted inference (local ComfyUI / OpenAPI — zero marginal $ when GPU is on)
SELFHOSTED_INFERENCE_URL=
SELFHOSTED_INFERENCE_TOKEN=
SELFHOSTED_INFERENCE_TIMEOUT_MS=180000
# Workspaces with monthlyBudgetCents <= this value force the zero-cost chain
FREE_TIER_BUDGET_CENTS=0

# Free-cloud (Pollinations FLUX) — no API key; disable with FREE_CLOUD_ENABLED=false
FREE_CLOUD_ENABLED=true
FREE_CLOUD_IMAGE_BASE=https://image.pollinations.ai/prompt
FREE_CLOUD_DEFAULT_MODEL=flux
FREE_CLOUD_WARMUP_MS=1800
FREE_CLOUD_TIMEOUT_MS=90000

# --- Web ---
# Leave NEXT_PUBLIC_API_URL empty so the Next.js rewrite keeps cookies same-origin.
# Local rewrite target (server-only):
API_PROXY=http://localhost:4000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SOCKET_URL=
